{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-native",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@constigo/shared": ["../../packages/shared/src"],
      "@constigo/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src", "App.tsx", "index.js", "env.d.ts", "nativewind-env.d.ts"]
}
